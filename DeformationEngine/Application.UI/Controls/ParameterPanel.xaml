<UserControl
    x:Class="Application.UI.Controls.ParameterPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Padding="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel IsEnabled="{Binding HasModel}">

                <TextBlock Text="Deformation Type" FontWeight="Bold" Margin="0,0,0,10"/>
                <ComboBox ItemsSource="{Binding AvailableModes}" 
                          SelectedItem="{Binding SelectedMode, Mode=TwoWay}" 
                          Margin="0,0,0,15"/>

                <Separator Margin="0,5,0,15" Background="{StaticResource BorderBrush}"/>

                <StackPanel Visibility="{Binding BasicPanelVisibility}">
                    <TextBlock Text="Basic Transformation" FontWeight="Bold" Margin="0,0,0,10"/>

                    <StackPanel DataContext="{Binding Gizmo}">
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Gizmo Mode:" Margin="4,0,10,0" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableModes}" 
                                      SelectedItem="{Binding Mode, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>

                    <Separator Margin="0,15,0,15" Background="{StaticResource BorderBrush}"/>
                    <Button Content="Bake Transformation" Click="BakeChanges_OnClick" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                    <Button Content="Restore Parameters" Click="ResetDeformations_OnClick"/>
                </StackPanel>

                <StackPanel Visibility="{Binding TwistPanelVisibility}">
                    <TextBlock Text="Twist Deformation" FontWeight="Bold" Margin="0,0,0,10"/>
                    <StackPanel DataContext="{Binding Deformers}">
                        <CheckBox Content="Prevent Self-Intersections" 
                                  IsChecked="{Binding PreventSelfIntersection, Mode=TwoWay}"
                                  Foreground="{StaticResource TextBrush}"
                                  Margin="0,0,0,15"/>

                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Axis:" Margin="4,0,0,0"/>
                                <ComboBox ItemsSource="{Binding AvailableAxes}" 
                                          SelectedItem="{Binding TwistAxis, Mode=TwoWay}" 
                                          Margin="4"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Pivot Point (0.0 to 1.0):" Margin="0,5,0,0"/>
                        <Slider Minimum="0" Maximum="1" 
                                Value="{Binding TwistPivot, Mode=TwoWay}" 
                                TickFrequency="0.1" LargeChange="0.2"/>

                        <TextBlock Text="Angle:" Margin="0,5,0,0"/>
                        <Slider Minimum="-12.56" Maximum="12.56" 
                                Value="{Binding TwistAngle, Mode=TwoWay}" 
                                TickFrequency="0.1" LargeChange="0.5"/>
                    </StackPanel>

                    <Separator Margin="0,15,0,15" Background="{StaticResource BorderBrush}"/>
                    <Button Content="Bake Transformation" Click="BakeChanges_OnClick" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                    <Button Content="Restore Parameters" Click="ResetDeformations_OnClick"/>
                </StackPanel>

                <StackPanel Visibility="{Binding BendPanelVisibility}">
                    <TextBlock Text="Bend Deformation" FontWeight="Bold" Margin="0,0,0,10"/>
                    <StackPanel DataContext="{Binding Deformers}">
                        <CheckBox Content="Prevent Self-Intersections" 
                                  IsChecked="{Binding PreventSelfIntersection, Mode=TwoWay}"
                                  Foreground="{StaticResource TextBrush}"
                                  Margin="0,0,0,15"/>

                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Length Axis:" Margin="4,0,0,0"/>
                                <ComboBox ItemsSource="{Binding AvailableAxes}" 
                                          SelectedItem="{Binding BendPrimaryAxis, Mode=TwoWay}" 
                                          Margin="4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Bend Towards:" Margin="4,0,0,0"/>
                                <ComboBox ItemsSource="{Binding AvailableAxes}" 
                                          SelectedItem="{Binding BendAxis, Mode=TwoWay}" 
                                          Margin="4"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Pivot Point (0.0 to 1.0):" Margin="0,5,0,0"/>
                        <Slider Minimum="0" Maximum="1" 
                                Value="{Binding BendPivot, Mode=TwoWay}" 
                                TickFrequency="0.1" LargeChange="0.2"/>

                        <TextBlock Text="Angle:" Margin="0,5,0,0"/>
                        <Slider Minimum="-6.28" Maximum="6.28" 
                                Value="{Binding BendAngle, Mode=TwoWay}" 
                                TickFrequency="0.1" LargeChange="0.5"/>
                    </StackPanel>

                    <Separator Margin="0,15,0,15" Background="{StaticResource BorderBrush}"/>
                    <Button Content="Bake Transformation" Click="BakeChanges_OnClick" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                    <Button Content="Restore Parameters" Click="ResetDeformations_OnClick"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>