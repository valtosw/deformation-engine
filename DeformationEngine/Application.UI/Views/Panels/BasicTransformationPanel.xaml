<UserControl 
    x:Class="Application.UI.Views.Panels.BasicTransformationPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Basic Transformation" FontWeight="Bold" Margin="0,0,0,10"/>

        <StackPanel DataContext="{Binding Gizmo}">
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Gizmo Mode:" Margin="4,0,10,0" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableModes}" 
                          SelectedItem="{Binding Mode, Mode=TwoWay}" />
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>