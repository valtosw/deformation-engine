<UserControl 
    x:Class="Application.UI.Views.Panels.BendDeformationPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Bend Deformation" FontWeight="Bold" Margin="0,0,0,10"/>

        <GroupBox Header="General Settings" Margin="0,0,0,12">
            <StackPanel Margin="6">
                <CheckBox Content="Prevent self-intersections" 
                          IsChecked="{Binding PreventSelfIntersection, Mode=TwoWay}"
                          Margin="4,4,4,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                        <TextBlock Text="Length Axis:" Margin="4,0,0,4"/>
                        <ComboBox ItemsSource="{Binding AvailableAxes}" 
                                  SelectedItem="{Binding BendPrimaryAxis, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                        <TextBlock Text="Bend Towards:" Margin="4,0,0,4"/>
                        <ComboBox ItemsSource="{Binding AvailableAxes}" 
                                  SelectedItem="{Binding BendAxis, Mode=TwoWay}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Deformation Settings" Margin="0,0,0,12">
            <StackPanel Margin="6">
                <TextBlock Text="Pivot Point" Margin="4,0,4,4"/>
                <Slider Minimum="0" Maximum="1" 
                        Value="{Binding BendPivot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                        TickFrequency="0.1" LargeChange="0.2"/>

                <TextBlock Text="Angle" Margin="4,10,4,4"/>
                <Slider Minimum="{Binding MinimumBendAngle}" Maximum="{Binding MaximumBendAngle}" 
                        Value="{Binding BendAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                        TickFrequency="0.1" LargeChange="0.5"/>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>