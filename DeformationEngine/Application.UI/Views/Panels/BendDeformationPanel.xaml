<UserControl 
    x:Class="Application.UI.Views.Panels.BendDeformationPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Bend Deformation" FontWeight="Bold" Margin="0,0,0,10"/>
        <StackPanel DataContext="{Binding Deformers}">
            <CheckBox Content="Prevent Self-Intersections" 
                      IsChecked="{Binding PreventSelfIntersection, Mode=TwoWay}"
                      Foreground="{StaticResource TextBrush}"
                      Margin="0,0,0,15"/>

            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Length Axis:" Margin="4,0,0,0"/>
                    <ComboBox ItemsSource="{Binding AvailableAxes}" 
                              SelectedItem="{Binding BendPrimaryAxis, Mode=TwoWay}" 
                              Margin="4"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Bend Towards:" Margin="4,0,0,0"/>
                    <ComboBox ItemsSource="{Binding AvailableAxes}" 
                              SelectedItem="{Binding BendAxis, Mode=TwoWay}" 
                              Margin="4"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Pivot Point (0.0 to 1.0):" Margin="0,5,0,0"/>
            <Slider Minimum="0" Maximum="1" 
                    Value="{Binding BendPivot, Mode=TwoWay}" 
                    TickFrequency="0.1" LargeChange="0.2"/>

            <TextBlock Text="Angle:" Margin="0,5,0,0"/>
            <Slider Minimum="{Binding MinimumBendAngle}" Maximum="{Binding MaximumBendAngle}" 
                    Value="{Binding BendAngle, Mode=TwoWay}" 
                    TickFrequency="0.1" LargeChange="0.5"/>
        </StackPanel>
    </StackPanel>
</UserControl>