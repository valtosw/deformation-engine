<UserControl 
    x:Class="Application.UI.Views.Panels.FfdDeformationPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Free-Form Deformation" FontWeight="Bold" Margin="0,0,0,10"/>

        <StackPanel DataContext="{Binding Deformers}">
            <TextBlock Text="X Axis Resolution:" Margin="0,5,0,0"/>
            <Slider Minimum="{Binding MinimumFfdResolution}" Maximum="{Binding MaximumFfdResolution}" Value="{Binding FfdResolutionX, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" LargeChange="1"/>

            <TextBlock Text="Y Axis Resolution:" Margin="0,5,0,0"/>
            <Slider Minimum="{Binding MinimumFfdResolution}" Maximum="{Binding MaximumFfdResolution}" Value="{Binding FfdResolutionY, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" LargeChange="1"/>

            <TextBlock Text="Z Axis Resolution:" Margin="0,5,0,0"/>
            <Slider Minimum="{Binding MinimumFfdResolution}" Maximum="{Binding MaximumFfdResolution}" Value="{Binding FfdResolutionZ, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" LargeChange="1"/>
        </StackPanel>

        <Button Content="Generate Lattice" Click="GenerateLattice_OnClick" Margin="0,15,0,5" Foreground="{StaticResource AccentBrush}"/>
        <Button Content="Subdivide Mesh" Click="SubdivideMesh_OnClick" Margin="0,0,0,5"/>
    </StackPanel>
</UserControl>
