<UserControl
    x:Class="Application.UI.Views.Panels.ParameterPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:panels="clr-namespace:Application.UI.Views.Panels">
    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" IsEnabled="{Binding HasModel}">
                <TextBlock Text="Deformation Type" FontWeight="Bold" Margin="0,0,0,10"/>
                <ComboBox ItemsSource="{Binding AvailableModes}" 
                          SelectedItem="{Binding SelectedMode, Mode=TwoWay}" 
                          Margin="0,0,0,5"/>
            </StackPanel>

            <Separator Grid.Row="1" Margin="0,10,0,10" Background="{StaticResource BorderBrush}"/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel IsEnabled="{Binding HasModel}">
                    <panels:BasicTransformationPanel Visibility="{Binding BasicPanelVisibility}"/>
                    <panels:TwistDeformationPanel Visibility="{Binding TwistPanelVisibility}"/>
                    <panels:BendDeformationPanel Visibility="{Binding BendPanelVisibility}"/>
                    <panels:FfdDeformationPanel Visibility="{Binding FfdPanelVisibility}"/>
                    <panels:LbsDeformationPanel Visibility="{Binding LbsPanelVisibility}"/>
                </StackPanel>
            </ScrollViewer>

            <Separator Grid.Row="3" Margin="0,10,0,10" Background="{StaticResource BorderBrush}"/>

            <StackPanel Grid.Row="4" IsEnabled="{Binding HasModel}">
                <Button Content="Bake Transformation" Click="BakeChanges_OnClick" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                <Button Content="Restore Parameters" Click="ResetDeformations_OnClick"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
